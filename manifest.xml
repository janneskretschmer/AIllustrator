<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="TaskPaneApp">
  <Id>55f664e2-9466-44d6-acf7-413d2bb9543b</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>AIllustrator</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="AIllustrator"/>
  <Description DefaultValue="Generates image overlays directly from slide text boxes."/>
  <IconUrl DefaultValue="https://janneskretschmer.github.io/AIllustrator/assets/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://janneskretschmer.github.io/AIllustrator/assets/icon-64.png"/>
  <SupportUrl DefaultValue="https://localhost:3000/help"/>
  <AppDomains>
    <AppDomain>https://localhost:3000</AppDomain>
    <AppDomain>https://janneskretschmer.github.io/AIllustrator</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Presentation"/>
  </Hosts>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://janneskretschmer.github.io/AIllustrator/taskpane.html"/>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Presentation">
        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title"/>
            <Description resid="GetStarted.Description"/>
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl"/>
          </GetStarted>
          <FunctionFile resid="Commands.Url"/>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="CommandsGroup">
                <Label resid="CommandsGroup.Label"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16"/>
                  <bt:Image size="32" resid="Icon.32x32"/>
                  <bt:Image size="80" resid="Icon.80x80"/>
                </Icon>
                <Control xsi:type="Button" id="TaskpaneButton">
                  <Label resid="TaskpaneButton.Label"/>
                  <Supertip>
                    <Title resid="TaskpaneButton.Label"/>
                    <Description resid="TaskpaneButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>ButtonId1</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://janneskretschmer.github.io/AIllustrator/assets/icon-16.png"/>
        <bt:Image id="Icon.32x32" DefaultValue="https://janneskretschmer.github.io/AIllustrator/assets/icon-32.png"/>
        <bt:Image id="Icon.80x80" DefaultValue="https://janneskretschmer.github.io/AIllustrator/assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="GetStarted.LearnMoreUrl" DefaultValue="https://go.microsoft.com/fwlink/?LinkId=276812"/>
        <bt:Url id="Commands.Url" DefaultValue="https://janneskretschmer.github.io/AIllustrator/commands.html"/>
        <bt:Url id="Taskpane.Url" DefaultValue="https://janneskretschmer.github.io/AIllustrator/taskpane.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GetStarted.Title" DefaultValue="Get started with AIllustrator!"/>
        <bt:String id="CommandsGroup.Label" DefaultValue="AIllustrator"/>
        <bt:String id="TaskpaneButton.Label" DefaultValue="Show AIllustrator"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="GetStarted.Description" DefaultValue="AIllustrator loaded successfully. Select a text box on your slide and click 'Show AIllustrator' to generate an image overlay."/>
        <bt:String id="TaskpaneButton.Tooltip" DefaultValue="Opens AIllustrator panel to turn slide text into image overlays."/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>